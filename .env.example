# Rexha Configuration Environment Variables

# Application Settings
REXHA_LOG_LEVEL=INFO
REXHA_FOLLOW_UP_TIMEOUT=30
REXHA_ALWAYS_ON_TOP=true

# Voice Subsystem
REXHA_WAKE_PHRASE="wake up rexha"
REXHA_MIC_DEVICE_INDEX=
REXHA_TTS_ENABLED=true
REXHA_TTS_RATE=175
REXHA_TTS_VOICE_ID=

# Storage & Sandboxed Paths
REXHA_DATA_DIR=data
REXHA_NOTES_DIR=
REXHA_PROJECTS_DIR=

# Optional AI Providers (leave blank to use deterministic engine only)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
